{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3000",
    "dev:reset": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev -p 3000",
    "dev:tail": "bash scripts/dev-tail.sh /tmp/portfolio-dev.log 40",
    "verify:route": "bash scripts/check-short.sh verify-route bash scripts/fast-verify-route.sh",
    "verify:route-smoke": "bash scripts/check-short.sh route-smoke bash scripts/check-route-smoke.sh",
    "check:crawlability": "bash scripts/check-short.sh crawlability node scripts/check-crawlability.mjs",
    "verify:predeploy": "npm run check:deploy-workflow && npm run check:source-budgets && npm run check:dead-code && npm run check:booking-url-drift && npm run check:case-study-registry && npm run check:guard-script-fixtures && npm run check:route-boundaries && npm run build && npm run check:bundle-budget-trends && npm run check:bundle-budgets && npm run typecheck",
    "build": "next build",
    "check:deploy-workflow": "bash scripts/check-short.sh deploy-workflow bash scripts/check-deploy-workflow.sh",
    "check:dead-code": "bash scripts/check-short.sh dead-code node scripts/check-dead-code.mjs",
    "check:booking-url-drift": "bash scripts/check-short.sh booking-url-drift node scripts/check-booking-url-drift.mjs",
    "check:case-study-registry": "bash scripts/check-short.sh case-study-registry node scripts/check-case-study-registry.mjs",
    "check:no-legacy-case-studies": "node scripts/check-no-legacy-case-studies.mjs",
    "check:guard-script-fixtures": "bash scripts/check-short.sh guard-script-fixtures node scripts/test-guard-scripts.mjs",
    "check:source-budgets": "bash scripts/check-short.sh source-budgets node scripts/check-source-budgets.mjs",
    "check:route-boundaries": "bash scripts/check-short.sh route-boundaries node scripts/check-route-boundaries.mjs",
    "check:bundle-budget-trends": "bash scripts/check-short.sh bundle-budget-trends node scripts/check-bundle-budget-trends.mjs",
    "check:bundle-budgets": "bash scripts/check-short.sh bundle-budgets node scripts/check-bundle-budgets.mjs",
    "start": "next start",
    "typecheck": "bash scripts/check-short.sh typecheck tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "framer-motion": "^12.36.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "motion": "^12.36.0",
    "next": "14.2.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^3.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.17.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
